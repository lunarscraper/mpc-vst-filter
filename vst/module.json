    { "key": "drive",  "name": "Drive",      "min": 0, "max": 30 },
    { "key": "sat",    "name": "Saturation", "options": ["OFF", "SOFT", "HARD", "FOLD"] },
    { "key": "emph",   "name": "Emphasis",   "min": 0, "max": 100 },
    { "key": "envamt", "name": "Env Amount", "min": -48, "max": 48 },
    { "key": "attack", "name": "Attack",     "min": 0, "max": 100 },
    { "key": "decay",  "name": "Decay",      "min": 0, "max": 100 },
    { "key": "thresh", "name": "Threshold",  "min": -60, "max": 0 },
    { "key": "warmth", "name": "Warmth",     "min": 0, "max": 100 },
    { "key": "width",  "name": "Width",      "min": 0, "max": 100 },
    { "key": "output", "name": "Output",     "min": -24, "max": 12 },
    { "key": "vowel",    "name": "Vowel",     "min": 0, "max": 100 },
